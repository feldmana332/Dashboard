# --- Database (Neon Postgres) ---
# Copy the connection string from your Neon project. Must allow SSL.
DATABASE_URL="postgres://USER:PASSWORD@HOST/dbname?sslmode=require"

# --- Admin access (shared password for you + your TA) ---
ADMIN_PASSWORD="choose-a-strong-shared-password"
# Used to sign the admin login cookie. Any long random string.
SESSION_SECRET="paste-a-long-random-string-here"

# --- Email (reuses your Gmail app-password setup) ---
# A Gmail address and an App Password (not your normal password).
GMAIL_SENDER="you@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

# --- Site ---
# Public base URL of the deployed site, used to build cancel links in emails.
# On Vercel this is set automatically; for local dev use http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
